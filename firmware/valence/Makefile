# generated by neuraltransistor -- cross-build for mps2-an385
CROSS   ?= arm-none-eabi-
CC       = $(CROSS)gcc
SIZE     = $(CROSS)size
OBJCOPY  = $(CROSS)objcopy

CFLAGS  = -mcpu=cortex-m3 -mthumb -Os -std=c99 -ffreestanding \
          -fno-common -ffunction-sections -fdata-sections \
          -Wall -Wextra -Werror -I.
LDFLAGS = -nostdlib -nostartfiles -Wl,--gc-sections -Wl,--build-id=none \
          -T valence.ld -Wl,-Map=valence.map

SRC = main.c startup.c valence.c valence_runtime.c

all: valence.elf size

valence.elf: $(SRC) valence.ld
	$(CC) $(CFLAGS) $(LDFLAGS) $(SRC) -o $@

size: valence.elf
	$(SIZE) $<

bin: valence.elf
	$(OBJCOPY) -O binary $< valence.bin

run: valence.elf
	qemu-system-arm -M mps2-an385 -nographic -semihosting -kernel $<

clean:
	rm -f valence.elf valence.bin valence.map

.PHONY: all size bin run clean
